[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game/world_object.gd" id="1"]
[ext_resource type="Script" path="res://addons/netfox/rollback/rollback-synchronizer.gd" id="2"]
[ext_resource type="Script" path="res://addons/netfox/tick-interpolator.gd" id="3"]

[node name="WorldObject" type="Node2D"]
script = ExtResource("1")

[node name="RollbackSynchronizer" type="Node" parent="." node_paths=PackedStringArray("root")]
script = ExtResource("2")
root = NodePath("..")
state_properties = Array[String]([":active", ":kind", ":owner_peer", ":global_position", ":velocity", ":spawn_tick", ":arm_tick", ":fuse_tick", ":explode_tick", ":landed", ":launches", ":blasts"])

[node name="TickInterpolator" type="Node" parent="." node_paths=PackedStringArray("root")]
script = ExtResource("3")
root = NodePath("..")
properties = Array[String]([":global_position"])

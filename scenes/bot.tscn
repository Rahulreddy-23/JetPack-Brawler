[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game/bot.gd" id="1"]
[ext_resource type="Script" path="res://scripts/input/bot_input.gd" id="2"]
[ext_resource type="Script" path="res://addons/netfox/rollback/rollback-synchronizer.gd" id="3"]
[ext_resource type="Script" path="res://addons/netfox/tick-interpolator.gd" id="4"]

[node name="Bot" type="CharacterBody2D"]
collision_layer = 4
collision_mask = 3
motion_mode = 1
script = ExtResource("1")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]

[node name="Input" type="Node" parent="."]
script = ExtResource("2")

[node name="RollbackSynchronizer" type="Node" parent="." node_paths=PackedStringArray("root")]
script = ExtResource("3")
root = NodePath("..")
state_properties = Array[String]([":global_position", ":velocity", ":fuel", ":thrust_level", ":dash_left", ":dash_cooldown_left", ":dash_dir", ":jet_buffer", ":jet_held_prev", ":dash_buffer", ":wall_grace_left", ":wall_nx", ":facing", ":drop_left", ":aim_dir"])
input_properties = Array[String](["Input:move", "Input:aim", "Input:jet", "Input:dash"])

[node name="TickInterpolator" type="Node" parent="." node_paths=PackedStringArray("root")]
script = ExtResource("4")
root = NodePath("..")
properties = Array[String]([":global_position"])
